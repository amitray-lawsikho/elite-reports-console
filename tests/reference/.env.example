# =====================================================================
#  REPORTS CONSOLE — CONFIGURATION
#  Copy this file to ".env" and fill in the real values.
#  Everything here can also be edited from the Settings tab in the UI.
# =====================================================================

# ---------------------------------------------------------------------
# LEADSQUARED  — the one source every report is built from
# ---------------------------------------------------------------------
# Settings -> API and Webhooks -> API Access Keys, in LeadSquared.
# The host may be pasted whole ("https://api-in21.leadsquared.com/v2/");
# the scheme and path are trimmed for you.
LSQ_HOST=api-in21.leadsquared.com
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=

# Leads per Leads.Get page (LeadSquared's maximum is 1000)
LSQ_PAGE_SIZE=1000
# LeadSquared returns ISO dates in UTC; true = shift them to IST
LSQ_DATES_ARE_UTC=true

# How far back the fetch reaches, and which date it filters on:
# assigned | modified | created | last_called. Both are editable per run.
DEFAULT_FETCH_DAYS=30
DEFAULT_FETCH_BASIS=modified

# How long a fetch and the reports built from it are kept
KEEP_HOURS=12
# Date format in the downloads (Python strftime)
DOWNLOAD_DATE_FORMAT="%d/%m/%Y %H:%M:%S"

# ---------------------------------------------------------------------
# ROSTER  — becomes the Team and Verticals columns and the slicers
# ---------------------------------------------------------------------
# Published Google Sheet (CSV) holding: Caller Name, Team Name, Vertical,
# Email id
ROSTER_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRT73ztvPNZSvIu5WLxo-3WQ76JMAnt4P9dITd4EAbjSvuDytfgvdfri1WPXotCjm_Etnb80_Q7S-wf/pub?gid=0&single=true&output=csv

# ---------------------------------------------------------------------
# SHARED SOURCES
# ---------------------------------------------------------------------
# Stage-change log — supplies Comment LSQ / Caller Comments, and fills in
# missing email addresses.
STAGE_LOG_URL=https://docs.google.com/spreadsheets/d/1Pep2utYPzlnaPCKRVPfQSNdFyMlRpljektmt7DYvHjM/export?format=csv&gid=1411983190
# Enrollment tracker used by Chat/Email/Referral and Incoming.
REV_SHEET_URL=https://docs.google.com/spreadsheets/d/1fFdwIWzS_JOcDLQ8ZP0BlNUm__OTW2vT99JB9hDukJA/export?format=csv&gid=337716200

# ---------------------------------------------------------------------
# CHAT / EMAIL / REFERRAL
# ---------------------------------------------------------------------
CER_COMBINED_URL=https://docs.google.com/spreadsheets/d/1hB3x_3Ww4_XXXaEQC_xPAxhld3dtYfb_zLNYNZgIc3Y/export?format=csv&gid=723301669
CER_PUSH_URL=https://script.google.com/macros/s/AKfycbw7SFbPltUazDrEWoB9qiAvZVdhSg6I3SsRLvE3ZiJGi5C6Xq5RPgEkuKUisM-VaMvBeg/exec

# ---------------------------------------------------------------------
# INCOMING
# ---------------------------------------------------------------------
# Historic calls. Its newest Call Date is the day the report was last
# prepared; Ozonetel is fetched from that day to today and merged in.
INCOMING_MASTER_URL=https://docs.google.com/spreadsheets/d/1hB3x_3Ww4_XXXaEQC_xPAxhld3dtYfb_zLNYNZgIc3Y/export?format=csv&gid=1765275690
INCOMING_PUSH_URL=https://script.google.com/macros/s/AKfycbyYqOjuDGgbsQkFjKyj4EmHz7zxx5mYPclOrkRpAw_ls6DMEyi-bkKJp0zDnSBba_ntZA/exec

# ---------------------------------------------------------------------
# OZONETEL — the Incoming report's calls (same key/username as the
# other Ozonetel app)
# ---------------------------------------------------------------------
OZONETEL_API_KEY=
OZONETEL_USERNAME=
OZONETEL_API_URL=https://in1-ccaas-api.ozonetel.com/ca_reports/fetchCDRDetails
# Sales incoming = these skills (LawSikho_Incoming / Arbitrage_Incoming).
OZONETEL_SKILLS=sales,Arbitrage_Sales
# Ozonetel allows 2 requests a minute.
OZONETEL_SLEEP_SECONDS=32
OZONETEL_PAGE_SIZE=500
# Finished days are cached for good; today is re-fetched after this long.
OZONETEL_TODAY_REFRESH_MINUTES=30

# ---------------------------------------------------------------------
# ZOHO SALESIQ — the Sales IQ Chats tab
# ---------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in
SALESIQ_SCREEN_NAME=addictivelearning

# ---------------------------------------------------------------------
# DIALERS — the same keys as Leads Console
# ---------------------------------------------------------------------
MCUBE_API_KEY=
MCUBE_AUTHORIZATION=
MCUBE_GETAGENTS_TOKEN=
MCUBE_EMPLOYEES_AUTHORIZATION=
MCUBE_AGENT_SOURCE=both
MCUBE_PRIORITY=1
MCUBE_RETRY_ATTEMPTS=3
MCUBE_RETRY_TIME=180
MCUBE_PUSH_BATCH_SIZE=200
ACEFONE_TOKEN=
ACEFONE_SKILL_LIST_ID=
ACEFONE_PRIORITY=30
ACEFONE_PUSH_BATCH_SIZE=500

# ---------------------------------------------------------------------
# HIGH PRIORITY
# ---------------------------------------------------------------------
# ROLL THESE OVER EVERY MONTH: what is in HP_CURRENT_MONTH_URL moves down
# into HP_PREVIOUS_MONTH_URL, and the new month's link goes on top. Both
# sheets are read and merged, de-duplicated on Prospect ID with the most
# recent Timestamp winning, so an overlap costs nothing.
HP_CURRENT_MONTH_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRcc_PLg4grrFReYEc5Qo6A_iAWcj_b4H27AZy0Rjld4PmB6SCeDP6nb8vhTb9Ha6_K6D7ngK82FDh5/pub?gid=0&single=true&output=csv
HP_PREVIOUS_MONTH_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTx_UoJJG8r1haKOrlfYMivp5QYvPHQ53Eh1ApdHprZn8uLgcndqg58haIkG8KiQ_jSgwqcA8f2Y_S-/pub?gid=0&single=true&output=csv

# The HP enrollment tracker's two tabs; only rows marked "new enrollment"
# are counted. Leave the second blank if there is only one tab.
HP_REV_URL_1=https://docs.google.com/spreadsheets/d/e/2PACX-1vR9ImdIoP2hqQ0kaYZR88il5IhzBL4tA9_i_dawmf_e2Y_oeWR2rv4MVJyZMHpRpSdM4zGncZkjmVSW/pub?gid=1275960172&single=true&output=csv
HP_REV_URL_2=https://docs.google.com/spreadsheets/d/e/2PACX-1vR9ImdIoP2hqQ0kaYZR88il5IhzBL4tA9_i_dawmf_e2Y_oeWR2rv4MVJyZMHpRpSdM4zGncZkjmVSW/pub?gid=196799956&single=true&output=csv

HP_PUSH_URL=https://script.google.com/macros/s/AKfycbwokWICjaaHXdbcjDdU03quNdynhgqjGqekRyBGnidImYW9AHkQYA2pZ3RJcDxwZs0kmA/exec

# ---------------------------------------------------------------------
# BREACH RULES — one set for all three reports, the dashboards and dialers
# ---------------------------------------------------------------------
# Asked for before every build and remembered here. Same rule as Leads
# Console: follow-up N+ days old and not called since, or no follow-up and
# no call in N days, or never called with no follow-up -> breached.
RULE_DAYS_FOLLOW_UP=2
RULE_DAYS_COUNSELLED=2
RULE_DAYS_CALL_BACK=2
# Less-dialled DNP: Call Not Connected / Call Not Picking Up where the
# counter (phone | assigned) is lt | gt | eq the value (eq takes 2-5 or 2,5).
DNP_COUNTER=phone
DNP_OPERATOR=lt
DNP_VALUE=4
# Counts of 1..N are spelt out ("3 times dialled"); above N it reads
# "Dialled more than N times".
DIAL_LABEL_MAX=6

# ---------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------
# 5200 keeps clear of Leads Console (5100) and the old console (5000).
PORT=5200
# Optional HTTP Basic Auth. Set BOTH to lock the console.
APP_USER=
APP_PASS=
# 0 pushes the whole report in one request; raise it only if a push times out.
PUSH_CHUNK_ROWS=0
PUSH_TIMEOUT_SECONDS=300
MAX_FILE_AGE_HOURS=12
